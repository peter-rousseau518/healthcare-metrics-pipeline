{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::peter-cms-nursing-home-2026/cms_nursing_home/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::peter-cms-nursing-home-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["cms_nursing_home/*"]
        }
      }
    }
  ]
}
